{
  "name": "ucc-platform",
  "version": "2.0.0",
  "private": true,
  "description": "Urgent Care Colombia — re-platformed monorepo (TS · React+Tailwind · microservices+Kong · Postgres+Prisma · Docker)",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev:auth": "npm run dev -w @ucc/auth-service",
    "dev:core": "npm run dev -w @ucc/core-service",
    "dev:notification": "npm run dev -w @ucc/notification-service",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspaces --if-present",
    "migrate:dev": "npm run migrate:dev --workspaces --if-present",
    "seed": "npm run seed --workspaces --if-present",
    "db:push": "node scripts/db-push-public.mjs",
    "db:copy-to-public": "node scripts/migrate-data-to-public.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "prisma@5.22.0": true
  }
}
