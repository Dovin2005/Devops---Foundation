# API gateway / compose environment
POSTGRES_USER=ucc
POSTGRES_PASSWORD=ucc
POSTGRES_DB=ucc
# Base connection URL WITHOUT any query string — compose appends ?schema=<svc> per service.
DATABASE_URL=postgresql://ucc:ucc@postgres:5432/ucc
# Optional extra query params appended after ?schema=<svc>; must start with & (e.g. &sslmode=require).
DATABASE_URL_EXTRA=
JWT_SECRET=dev-change-me
INTERNAL_SERVICE_SECRET=dev-change-me-internal
# billing-service Stripe integration. Leave both empty to run the deterministic
# mock gateway (dev/tests/Postman work end to end without a real Stripe account).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 32+ char secret used to derive the AES-256-GCM key for encrypting third-party
# credentials at rest (auth-service Settings module). Auth-service only.
ENCRYPTION_MASTER_KEY=dev-change-me-encryption-key
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
WEB_ORIGIN=http://localhost:5173
