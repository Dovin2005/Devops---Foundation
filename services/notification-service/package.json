{
  "name": "@ucc/notification-service",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/with-db-env.mjs tsx watch src/server.ts",
    "start": "node ../../scripts/with-db-env.mjs node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "migrate:dev": "node ../../scripts/with-db-env.mjs prisma migrate dev",
    "migration:run": "node ../../scripts/with-db-env.mjs prisma migrate deploy",
    "seed": "node ../../scripts/with-db-env.mjs tsx src/seed.ts",
    "test": "node ../../scripts/with-db-env.mjs vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sendgrid/mail": "^8.1.6",
    "@ucc/service-kit": "*",
    "@ucc/types": "*",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "pg": "^8.13.0",
    "twilio": "^6.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
