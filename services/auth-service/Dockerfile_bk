# auth-service — built from the monorepo root context.
FROM node:20-alpine AS base
WORKDIR /app
# Prisma engine detection needs the openssl CLI; without it Alpine defaults to
# the OpenSSL 1.1 engine, which cannot load against Alpine's OpenSSL 3.
RUN apk add --no-cache openssl
COPY package.json package-lock.json* tsconfig.base.json ./
COPY packages/types ./packages/types
COPY packages/service-kit ./packages/service-kit
COPY services/auth-service ./services/auth-service
RUN npm install --workspaces --include-workspace-root=false || npm install
RUN npm run build -w @ucc/types \
 && npm run build -w @ucc/service-kit \
 && npm run build -w @ucc/auth-service
EXPOSE 4001
# Dev/compose: create tables once with `prisma db push` (no migrations checked in yet).
# For real prod, generate migrations and run `npm run migration:run` before starting.
CMD ["node", "services/auth-service/dist/server.js"]
