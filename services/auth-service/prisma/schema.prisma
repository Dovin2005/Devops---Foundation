generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String   @id @default(uuid()) @db.Uuid
  role                   String   @db.VarChar(32)
  email                  String   @db.VarChar(255)
  passwordHash           String   @db.VarChar(255)
  firstName              String   @db.VarChar(120)
  lastName               String   @db.VarChar(120)
  phone                  String?  @db.VarChar(40)
  city                   String?  @db.VarChar(60)
  status                 String   @default("active") @db.VarChar(32)
  languagePref           String   @default("es") @db.VarChar(12)
  mfaEnabled             Boolean  @default(false)
  patientId              String?  @db.Uuid
  locationId             String?  @db.Uuid
  physicianType          String?  @db.VarChar(20)
  // Doctor specialty catalog (Category, below) — denormalized names alongside
  // the ids for display, same pattern as Location.officeManagerId/Name.
  physicianSpecialtyIds  String[] @default([]) @db.Uuid
  physicianSpecialtyNames String[] @default([])
  physicianLicenseNo     String?  @db.VarChar(60)
  credentialsVerified    Boolean  @default(false)
  // Stripe Customer for saved payment methods (billing-service owns the
  // Stripe SDK calls; this service only stores the id — see internalUsers.routes).
  stripeCustomerId       String?  @unique @db.VarChar(64)
  // OTP (registration verification + forgot-password). Code is stored hashed,
  // same pattern as RefreshToken.tokenHash — never persisted in plaintext.
  otpCodeHash            String?  @db.VarChar(128)
  otpPurpose             String?  @db.VarChar(20)
  otpExpiresAt           DateTime? @db.Timestamptz
  otpSentVia             String?  @db.VarChar(10)
  otpLastSentAt          DateTime? @db.Timestamptz
  otpAttempts            Int      @default(0)
  createdAt              DateTime @default(now()) @db.Timestamptz
  updatedAt              DateTime @updatedAt @db.Timestamptz

  @@unique([email, role])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(128)
  expiresAt  DateTime  @db.Timestamptz
  revokedAt  DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  @@index([userId])
  @@map("refresh_tokens")
}

// Clinic locations (Multi-Clinic Management). Office manager is referenced by
// id only (this service owns User); name is denormalized for display.
model Location {
  id                String   @id @default(uuid()) @db.Uuid
  city              String   @db.VarChar(60)
  name              String   @db.VarChar(120)
  address           String?  @db.VarChar(240)
  phone             String?  @db.VarChar(40)
  officeManagerId   String?  @db.Uuid
  officeManagerName String?  @db.VarChar(120)
  openTime          String?  @db.VarChar(5) // 24h "HH:mm", e.g. "09:00"
  closeTime         String?  @db.VarChar(5) // 24h "HH:mm", e.g. "21:00"
  latitude          Float?
  longitude         Float?
  status            String   @default("active") @db.VarChar(16)
  settings          Json     @default("{}")
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @updatedAt @db.Timestamptz

  @@index([city])
  @@map("locations")
}

// Permission matrix per canonical role (exactly eight rows, seeded — roles are
// never created or deleted, only reconfigured).
model RoleConfig {
  role        String   @id @db.VarChar(32)
  scope       String   @db.VarChar(60)
  description String?  @db.VarChar(240)
  permissions Json     @default("{}")
  phiExport   String   @default("none") @db.VarChar(24)
  updatedBy   String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz

  @@map("role_configs")
}

// Global platform settings, one row per namespaced key (pricing.defaultMarkupPct,
// integrations.wompi.status, notifications.email.enabled, ...).
model PlatformSetting {
  key       String   @id @db.VarChar(80)
  value     Json
  updatedBy String?  @db.Uuid
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("platform_settings")
}

// Third-party integration credentials (Stripe/Twilio/SendGrid/Google/Firebase/...),
// managed by Super Admin. Secret values are encrypted at rest (packages/service-kit
// crypto.ts) — only auth-service holds the master key to decrypt. One row per
// provider+key so new providers/fields need no schema change.
model IntegrationCredential {
  id             String   @id @default(uuid()) @db.Uuid
  provider       String   @db.VarChar(40)
  key            String   @db.VarChar(80)
  valueEncrypted String   @db.Text
  isSecret       Boolean  @default(true)
  updatedBy      String?  @db.Uuid
  updatedAt      DateTime @updatedAt @db.Timestamptz
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@unique([provider, key])
  @@map("integration_credentials")
}

// Administrative audit trail. Actor identifiers only — never patient PII in
// detail payloads (Domain Cautions).
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  actorRole String?  @db.VarChar(32)
  actorName String?  @db.VarChar(120)
  action    String   @db.VarChar(60)
  entity    String   @db.VarChar(60)
  entityId  String?  @db.VarChar(64)
  detail    Json?
  requestId String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

// ---- Public site content (CMS) — admin-managed via superadmin-service,
// served publicly from this service under /api/auth/public. Gated by the
// 'marketing' permission module rather than a hardcoded role (see requirePermission).

// Doctor specialty catalog. core-service's Provider links to these ids
// (Provider.specialtyIds) — plain array, no cross-service FK, same convention
// as every other cross-service reference in this codebase.
model Category {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(80)
  slug         String   @unique @db.VarChar(80)
  description  String?  @db.VarChar(400)
  icon         String?  @db.VarChar(80)
  displayOrder Int      @default(0)
  status       String   @default("active") @db.VarChar(16)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  @@index([status])
  @@map("categories")
}

// Public "Services" page catalog (urgent care visit, labs, imaging, ...).
model ServiceOffering {
  id           String   @id @default(uuid()) @db.Uuid
  title        String   @db.VarChar(120)
  description  String?  @db.VarChar(400)
  priceLabel   String?  @db.VarChar(60)
  icon         String?  @db.VarChar(80)
  displayOrder Int      @default(0)
  status       String   @default("active") @db.VarChar(16)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  @@index([status])
  @@map("services_catalog")
}

model Faq {
  id           String   @id @default(uuid()) @db.Uuid
  category     String   @db.VarChar(60)
  question     String   @db.VarChar(240)
  answer       String   @db.VarChar(2000)
  displayOrder Int      @default(0)
  status       String   @default("draft") @db.VarChar(16)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  @@index([status])
  @@map("faqs")
}

model Career {
  id             String   @id @default(uuid()) @db.Uuid
  title          String   @db.VarChar(120)
  department     String   @db.VarChar(60)
  location       String   @db.VarChar(80)
  employmentType String   @db.VarChar(40)
  description    String   @db.VarChar(4000)
  requirements   String?  @db.VarChar(4000)
  displayOrder   Int      @default(0)
  status         String   @default("open") @db.VarChar(16)
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  @@index([status])
  @@map("careers")
}

// Patient testimonials ("Feedback From Our Patients"). Public submit →
// pending; admin approves/rejects; public list shows approved only.
model Testimonial {
  id          String    @id @default(uuid()) @db.Uuid
  patientName String    @db.VarChar(120)
  rating      Int
  quote       String    @db.VarChar(1000)
  status      String    @default("pending") @db.VarChar(16)
  reviewedBy  String?   @db.Uuid
  reviewedAt  DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@index([status])
  @@map("testimonials")
}

// Contact Us submissions (public form → admin inbox).
model ContactSubmission {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(120)
  email           String   @db.VarChar(255)
  phone           String?  @db.VarChar(40)
  serviceCategory String?  @db.VarChar(80)
  reason          String?  @db.VarChar(200)
  message         String   @db.VarChar(2000)
  status          String   @default("new") @db.VarChar(16)
  createdAt       DateTime @default(now()) @db.Timestamptz

  @@index([status])
  @@map("contact_submissions")
}
